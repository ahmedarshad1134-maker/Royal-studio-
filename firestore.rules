rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      // Single consistent admin role check:
      // Primary: Firebase Custom Claims (token.role == 'admin' or token.admin == true)
      // Secondary fallback: Firestore users/{uid}.role == 'admin'
      return isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile; Admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();
      
      // On creation, non-admins can only create their own profile with role == 'customer'
      allow create: if (isOwner(userId) && request.resource.data.role == 'customer') || isAdmin();
      
      // On update:
      // Non-admins can only update their own profile
      // Non-admins cannot modify their own role (must stay 'customer')
      // Non-admins cannot modify or touch admin user accounts
      // Users cannot change their uid
      allow update: if (
        isOwner(userId) && 
        resource.data.role == 'customer' &&
        request.resource.data.role == 'customer' &&
        (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid)
      ) || isAdmin();
      
      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      // Customers can read strictly only their own bookings (by email or customerId)
      // Admins can read all bookings
      allow read: if isAuthenticated() && (
        (resource.data.customerId != null && resource.data.customerId == request.auth.uid) ||
        (resource.data.email != null && resource.data.email == request.auth.token.email) ||
        isAdmin()
      );
      // Customers or guests can submit enquiries (initial status must be NEW, internal adminNotes cannot be set)
      allow create: if request.resource.data.status == 'NEW' && 
                       (!('adminNotes' in request.resource.data) || request.resource.data.adminNotes == null || request.resource.data.adminNotes == '');
      // Only authorized admins can update status, internal notes, or delete bookings
      allow update, delete: if isAdmin();
    }

    // Services collection
    match /services/{serviceId} {
      // Anyone can read services
      allow read: if true;
      // Only admins can modify
      allow write: if isAdmin();
    }

    // Packages collection
    match /packages/{packageId} {
      // Anyone can read packages
      allow read: if true;
      // Only admins can modify
      allow write: if isAdmin();
    }

    // Portfolio collection
    match /portfolio/{itemId} {
      // Anyone can read portfolio items
      allow read: if true;
      // Only admins can modify
      allow write: if isAdmin();
    }

    // Reviews collection
    match /reviews/{reviewId} {
      // Anyone can read approved reviews; Admins can read all
      allow read: if resource.data.approved == true || isAdmin();
      // Authenticated customers can create reviews, but approved must be false
      allow create: if isAuthenticated() && request.resource.data.approved == false;
      // Only admins can approve, update or delete reviews
      allow update, delete: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read strictly only their own notifications
      allow read: if isAuthenticated() && (
        (resource.data.recipientUserId != null && (
          resource.data.recipientUserId == request.auth.token.email || 
          resource.data.recipientUserId == request.auth.uid
        )) ||
        isAdmin()
      );
      // Users can only mark their own notifications as read
      allow update: if isAuthenticated() && (
        resource.data.recipientUserId == request.auth.token.email || 
        resource.data.recipientUserId == request.auth.uid
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'isRead']);
      // System/Admins create or delete notifications
      allow create, delete: if isAdmin();
    }

    // Studio settings collection
    match /studioSettings/{settingId} {
      // Anyone can read public settings (like contact info)
      allow read: if true;
      // Only admins can modify
      allow write: if isAdmin();
    }

    // Blocked Dates
    match /blockedDates/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Invoices and Receipts collection
    match /invoices/{invoiceId} {
      // Customers can read strictly only their own invoices (matched by email or customerId)
      // Admins can read any invoice
      allow read: if isAuthenticated() && (
        (resource.data.customerId != null && resource.data.customerId == request.auth.uid) ||
        (resource.data.customerEmail != null && resource.data.customerEmail == request.auth.token.email) ||
        isAdmin()
      );
      // Only authorized admins can create, update, or delete invoices and payment records
      allow write: if isAdmin();
    }

    // Contact Messages collection
    match /contactMessages/{messageId} {
      // Anyone can create a document with required fields name, phone, message non-empty
      allow create: if request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                       request.resource.data.phone is string && request.resource.data.phone.size() > 0 &&
                       request.resource.data.message is string && request.resource.data.message.size() > 0;
      // Only admins can read, update or delete
      allow read, update, delete: if isAdmin();
    }
  }
}
